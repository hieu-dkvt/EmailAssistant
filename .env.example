# Mẫu biến môi trường. Sao chép thành .env để đổi mật khẩu (.env không được commit).
# Giá trị dưới đây là mặc định cho máy dev; docker-compose và backend dùng chúng khi không có .env.

# docker compose (chỉ có hiệu lực khi volume DB được tạo lần đầu)
POSTGRES_PASSWORD=dev-postgres
APP_OWNER_PASSWORD=dev-owner
APP_API_PASSWORD=dev-api
APP_WORKER_PASSWORD=dev-worker

# backend (đặt làm biến môi trường của tiến trình; backend không tự đọc file .env)
DATABASE_URL_OWNER=postgresql+psycopg://app_owner:dev-owner@127.0.0.1:15432/mailassist
DATABASE_URL_API=postgresql+psycopg://app_api:dev-api@127.0.0.1:15432/mailassist
DATABASE_URL_WORKER=postgresql+psycopg://app_worker:dev-worker@127.0.0.1:15432/mailassist
